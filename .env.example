# ----------------------------------------------------------------------------
# GolfCarry.Store environment variables
# Copy this file to `.env.local` and fill in your values. Never commit secrets.
# ----------------------------------------------------------------------------

# Your public site URL (used for SEO canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://golfcarry.store"

# ---- Shopify Storefront API ----
# Shopify admin: Settings → Apps and sales channels → Develop apps → create an
# app → Storefront API. Grant: read products, read collections, manage cart/checkout.
#
# Store domain WITHOUT the protocol, e.g. golfcarry.myshopify.com
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Public Storefront API access token (safe to expose to the browser).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Storefront API version. Bump quarterly as Shopify releases new versions.
SHOPIFY_API_VERSION="2025-01"

# Secret used to validate Shopify webhook calls to /api/revalidate so product/
# collection edits in Shopify instantly refresh the cached storefront.
SHOPIFY_REVALIDATION_SECRET=""

# ---- Optional integrations (see README "Apps & Integrations") ----
# Reviews (Judge.me / Loox / Okendo) — public widget/shop token.
NEXT_PUBLIC_REVIEWS_PROVIDER=""
NEXT_PUBLIC_REVIEWS_PUBLIC_TOKEN=""

# Email marketing / newsletter (Klaviyo public API key, etc.).
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=""

# Analytics & conversion tracking.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
